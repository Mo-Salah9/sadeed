# Copy this file to .env.local and fill in the values.

# Public URL of the site (no trailing slash). Used for canonical URLs, Open Graph tags and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://www.sadeedstudio.com

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered (comma-separate multiple addresses)
CONTACT_EMAIL=hello@sadeedstudio.com

# Optional: sender address. Must be on a domain verified in Resend.
# Defaults to Resend's test sender (onboarding@resend.dev), which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL="SADEED Website <website@sadeedstudio.com>"
